const copy = content[lang];
const all = copy.groups.flatMap((g) => g.items);
const crumbs = [{ label: t("breadcrumb.home"), href: href(lang) }, { label: t("nav.faq") }];
const linkHref = (path: string) => (path.startsWith("http") ? path : href(lang, path));
---

<Base
  lang={lang}
  title={copy.title}
  description={copy.description}
  section="faq"
  path="faq/"
  ogImage={`/og/${lang}/faq.png`}
  jsonLd={[
    faqPage(lang, all),
    breadcrumbList([
      { name: t("breadcrumb.home"), url: new URL(href(lang), site).href },
      { name: t("nav.faq"), url: new URL(href(lang, "faq/"), site).href },
    ]),
  ]}
>
  <div class="wrap pt-10 pb-24 lg:pt-14">
    <Breadcrumbs items={crumbs} label={t("breadcrumb.home")} />
    <h1 class="display mt-6">{copy.h1}</h1>
    <p class="lede mt-5">{copy.lede}</p>

    {
      copy.groups.map((g, gi) => (
        <section class="group" aria-labelledby={`faq-g${gi}`}>
          <h2 id={`faq-g${gi}`} class="folio group-h">
            {g.title}
          </h2>
          <div class="qa-list">
            {g.items.map((item) => (
              <div class="qa">
                <h3 class="h3 q">{item.q}</h3>
                <div class="a">
                  <p>{item.a}</p>
                  {item.link && (
                    <a class="link mt-2 inline-block font-medium" href={linkHref(item.link[0])}>
                      {item.link[1]}
                    </a>
                  )}
                </div>
              </div>
            ))}
          </div>
        </section>
      ))
    }
  </div>
</Base>

<style>
  .group {
    margin-top: clamp(3rem, 6vw, 4.5rem);
  }

  .group-h {
    margin-bottom: 0.75rem;
  }

  .qa-list {
    border-top: 1.5px solid var(--ink);
  }

  .qa {
    display: grid;
    gap: 0.6rem;
    padding: 1.4rem 0;
    border-bottom: 1px solid var(--rule);
  }

  .a {
    color: var(--ink-2);
    max-width: 44rem;
  }

  @media (min-width: 56rem) {
    .qa {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      gap: 3rem;
    }
  }
</style>
