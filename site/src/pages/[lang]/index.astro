            ],
            [
                "lexo pdf rotate book.pdf -d 90 -o rotated.pdf",
                "စာမျက်နှာများ လှည့်ခြင်း",
            ],
            [
                "lexo pdf merge a.pdf b.pdf -o book.pdf",
                "ဖိုင်များကို အစဉ်လိုက် ပေါင်းခြင်း",
            ],
        ],
        toolsMore: "CLI အပြည့်အစုံ",
        videosTitle: "သုံးမိနစ်ဖြင့် လုပ်ဆောင်ပုံကို လေ့လာပါ",
        videosLede:
            "LEXO ကို အသုံးပြုပြီး ရိုက်ကူးထားတဲ့ လမ်းညွှန်ဗီဒီယိုတို သုံးခု ဖြစ်ပါတယ်။ အသံမပါဘဲ မျက်နှာပြင်ပေါ်က စာတန်းတွေနဲ့ ရှင်းပြထားပါတယ်။",
        useTitle: "ဘယ်သူတွေအတွက် အသုံးဝင်သလဲ",
        uses: [
            ["သုတေသီများနှင့် မော်ကွန်းတိုက်များ", "use-cases/#research"],
            ["ထုတ်ဝေသူများနှင့် EPUB ထုတ်လုပ်ခြင်း", "use-cases/#publishing"],
            ["မြန်မာ NLP Dataset များ", "use-cases/#datasets"],
            [
                "ဖောင့်ဟောင်းဖြင့် ရိုက်ထားတဲ့ စာရွက်စာတမ်းများ",
                "use-cases/#legacy-fonts",
            ],
            ["ကျောင်းသားများနှင့် ဆရာများ", "use-cases/#education"],
        ],
        openTitle: "အခမဲ့ အသုံးပြုနိုင်တဲ့ Open Source ဆော့ဖ်ဝဲ",
        openBody:
            "LEXO ကို AGPL-3.0 လိုင်စင်ဖြင့် ထုတ်ဝေထားပါတယ်။ LEXO အကောင့်ဖွင့်ဖို့ မလိုသလို လစဉ်ကြေးနဲ့ စာမျက်နှာအလိုက် အခကြေးငွေလည်း မရှိပါဘူး။ Google Docs OCR ကို မိမိ Google အကောင့်ဖြင့် အခမဲ့ သုံးနိုင်ပါတယ်။ အက်ပ်နဲ့ CLI က တူညီတဲ့ အခြေခံစနစ်ကို သုံးထားလို့ အက်ပ်မှာ စမ်းထားတဲ့ လုပ်ငန်းစဉ်ကို script ရေးပြီး ထပ်မံလုပ်ဆောင်နိုင်ပါတယ်။",
        openRepo: "GitHub ရှိ Source Code",
        openContrib: "ပါဝင်ကူညီနည်း",
        closeTitle: "LEXO ကို ထည့်သွင်းပါ",
        closeBody:
            "Python package တစ်ခုတည်းမှာ Desktop app နဲ့ CLI နှစ်မျိုးလုံး ပါဝင်ပါတယ်။ လိုအပ်တဲ့ အခြားဆော့ဖ်ဝဲတွေကို သီးခြား ထည့်သွင်းစရာ မလိုပါဘူး။",
    },
}[lang];

const stepImages = [welcome, cropEditor, ocrRunning, proofread, exportDone];
const stepExtras = {
    en: {
        proof: "A doubled vowel sign from a PDF text layer, corrected in LEXO's text pane.",
        output: "Page 1 of the Markdown LEXO exported after that correction, unedited.",
    },
    my: {
        proof: "PDF Text layer မှာ ထပ်နေတဲ့ သရအမှတ်ကို LEXO Text pane မှာ ပြင်ဆင်ထားပုံ။",
        output: "ပြင်ဆင်ပြီးနောက် LEXO မှ ထုတ်ယူထားတဲ့ Markdown ရဲ့ ပထမစာမျက်နှာကို ထပ်မပြင်ဘဲ ပြထားပါတယ်။",
    },
}[lang];
const extras = [
    undefined,
    undefined,
    undefined,
    {
        kind: "proof" as const,
        wrong: "နိုိုင်",
        right: "နိုင်",
        note: stepExtras.proof,
    },
    {
        kind: "output" as const,
        file: "lexo-sample-digital.md",
        text: exportSample.trim(),
        note: stepExtras.output,
    },
];
const steps = copy.steps.map((s, i) => ({
    ...s,
    image: stepImages[i] ?? welcome,
    extra: extras[i],
}));
const specimen = [
    ["မ", "U+1019"],
    ["ြ", "U+103C"],
    ["န", "U+1014"],
    ["်", "U+103A"],
    ["မ", "U+1019"],
    ["ာ", "U+102C"],
];
const v = videoCopy[lang];
---

<Base
    lang={lang}
    title={copy.title}
    description={copy.description}
    section="home"
    path=""
    ogImage={`/og/${lang}/home.png`}
    jsonLd={[
        softwareApplication(lang, url, copy.description),
        website(lang, url),
    ]}
>
    <!-- Hero: the scanner bed -->
    <section class="wrap hero">
        <div class="hero-copy">
            <h1 class="display hero-title">
                {copy.headline.map((line) => (
                    <span class="block">{line}</span>
                ))}
            </h1>
            <p class="echo" lang={copy.echoLang}>
                {copy.echo}
            </p>
            <p class="lede mt-6">{copy.lede}</p>
            <InstallTicket
                lang={lang}
                id="hero-install"
                class="mt-8 max-w-136"
            />
            <div class="mt-5 flex flex-wrap gap-3">
                <a class="btn btn-line" href={LINKS.repo}>
                    <Icon name="github" size={18} />
                    {t("cta.github")}
                </a>
                <a class="btn btn-line" href="#walkthroughs">
                    <Icon name="play" size={16} />
                    {copy.watch}
                </a>
            </div>
        </div>
        <div class="hero-bed">
            <ScanCompare lang={lang} />
        </div>
    </section>

    <div class="wrap">
        <ul class="facts">
            {copy.facts.map((f) => (
                <li>{f}</li>
            ))}
            <li lang="en">AGPL-3.0</li>
            <li>
                <a class="link" href={sectionHref(lang, "changelog")} lang="en">
                    v{VERSION}
                </a>
            </li>
        </ul>
    </div>

    <!-- Promo -->
    <section class="section" aria-labelledby="promo-title">
        <div class="wrap">
            <div class="max-w-3xl">
                <h2 id="promo-title" class="h2">
                    {copy.promoTitle}
                </h2>
                <p class="lede mt-4">{copy.promoLede}</p>
            </div>
            <YouTubeEmbed
                class="mt-10"
                youtubeId={PROMO.youtubeId}
                poster={promoPoster}
                posterWidth={1280}
                title={copy.promoTitle}
                playLabel={copy.promoPlay}
            />
        </div>
    </section>

    <!-- The honest network ledger -->
    <section class="section" aria-labelledby="ledger-title">
        <div class="wrap">
            <div class="max-w-3xl">
                <h2 id="ledger-title" class="h2">
                    {copy.ledgerTitle}
                </h2>
                <p class="lede mt-4">{copy.ledgerLede}</p>
            </div>
            <div class="ledger mt-10">
                <div class="ledger-col">
                    <h3 class="ledger-head">
                        <Icon name="monitor" size={20} />
                        {copy.localTitle}
                    </h3>
                    <ul>
                        {copy.localItems.map((item) => (
                            <li>{item}</li>
                        ))}
                    </ul>
                </div>
                <div class="ledger-col cloud">
                    <h3 class="ledger-head">
                        <Icon name="cloud" size={20} />
                        {copy.cloudTitle}
                    </h3>
                    <p class="tag mb-3">{copy.cloudBadge}</p>
                    <ul>
                        {copy.cloudItems.map((item) => (
                            <li
                                set:html={item
                                    .replace(
                                        "drive.file",
                                        '<code lang="en">drive.file</code>',
                                    )
                                    .replace(
                                        "lexo logout",
                                        '<code lang="en">lexo logout</code>',
                                    )}
                            />
                        ))}
                    </ul>
                </div>
            </div>
            <p class="setup-note mt-8">
                <Icon name="lock" size={18} class="mt-1 shrink-0 text-ink-3" />
                <span>
                    {copy.setupNote}{" "}
                    <a
                        class="link font-medium"
                        href={href(lang, "docs/google-cloud-setup/")}
                    >
                        {copy.setupLink}
                    </a>
                </span>
            </p>
        </div>
    </section>

    <!-- Workflow on the bed -->
    <section class="section rule-top" aria-labelledby="flow-title">
        <div class="wrap">
            <div class="max-w-3xl">
                <h2 id="flow-title" class="h2">
                    {copy.flowTitle}
                </h2>
                <p class="lede mt-4">{copy.flowLede}</p>
            </div>
            <div class="mt-12">
                <Workflow lang={lang} steps={steps} />
            </div>
        </div>
    </section>

    <!-- Myanmar specifics -->
    <section class="section rule-top" aria-labelledby="my-title">
        <div class="wrap grid gap-12 lg:grid-cols-[1fr_1fr] lg:gap-16">
            <div>
                <h2 id="my-title" class="h2">
                    {copy.myTitle}
                </h2>
                <p class="lede mt-4">{copy.myLede}</p>
                <dl class="points mt-10">
                    {copy.myPoints.map((p) => (
                        <div>
                            <dt class="h3 text-ink">{p.term}</dt>
                            <dd class="mt-2 text-ink-2">{p.body}</dd>
                        </div>
                    ))}
                </dl>
            </div>
            <div class="flex flex-col gap-10">
                <figure class="specimen platen">
                    <div class="specimen-word" lang="my">
                        မြန်မာ
                    </div>
                    <ol class="specimen-cells" aria-label={copy.specimenLabel}>
                        {specimen.map(([glyph, cp]) => (
                            <li>
                                <span class="glyph" lang="my">
                                    {glyph === "ြ" ||
                                    glyph === "်" ||
                                    glyph === "ာ"
                                        ? `◌${glyph}`
                                        : glyph}
                                </span>
                                <span class="cp">{cp}</span>
                            </li>
                        ))}
                    </ol>
                    <figcaption class="folio mt-4">
                        {copy.specimenLabel}
                    </figcaption>
                </figure>
                <Shot
                    src={legacyFrame}
                    alt={copy.legacyCaption}
                    caption={copy.legacyCaption}
                    sizes="(min-width: 64rem) 44vw, 94vw"
                />
            </div>
        </div>
    </section>

    <!-- Batch -->
    <section class="section rule-top" aria-labelledby="batch-title">
        <div class="wrap grid items-start gap-12 lg:grid-cols-[1fr_1.15fr] lg:gap-16">
            <div>
                <h2 id="batch-title" class="h2">
                    {copy.batchTitle}
                </h2>
                <p class="lede mt-4">{copy.batchBody}</p>
                <Command
                    lang={lang}
                    command="lexo ocr-batch ./pdfs --out-dir ./txt"
                    class="mt-8"
                />
                <ul class="ticks mt-6">
                    {copy.batchFacts.map((f) => (
                        <li>{f}</li>
                    ))}
                </ul>
            </div>
            <div class="platen">
                <Picture
                    src={batchDialog}
                    alt={copy.batchAlt}
                    formats={["avif"]}
                    fallbackFormat="webp"
                    widths={[630, 1260]}
                    sizes="(min-width: 64rem) 46vw, 94vw"
                    loading="lazy"
                    class="shot"
                />
            </div>
        </div>
    </section>

    <!-- PDF tools -->
    <section class="section rule-top" aria-labelledby="tools-title">
        <div class="wrap">
            <div class="max-w-3xl">
                <h2 id="tools-title" class="h2">
                    {copy.toolsTitle}
                </h2>
                <p class="lede mt-4">{copy.toolsLede}</p>
            </div>
            <dl class="tools mt-10">
                {copy.tools.map(([cmd, label]) => (
                    <div class="tool-row">
                        <dt>{label}</dt>
                        <dd>
                            <Command lang={lang} command={cmd ?? ""} />
                        </dd>
                    </div>
                ))}
            </dl>
            <a class="btn btn-line mt-8" href={href(lang, "docs/cli/")}>
                {copy.toolsMore}
                <Icon name="arrow" size={18} />
            </a>
        </div>
    </section>

    <!-- Walkthroughs -->
    <section
        id="walkthroughs"
        class="section rule-top"
        aria-labelledby="videos-title"
    >
        <div class="wrap">
            <div class="max-w-3xl">
                <h2 id="videos-title" class="h2">
                    {copy.videosTitle}
                </h2>
                <p class="lede mt-4">{copy.videosLede}</p>
            </div>
            <div class="videos mt-12">
                <Walkthrough
                    lang={lang}
                    id="scanned"
                    title={v.scanned.title}
                    summary={v.scanned.summary}
                    class="lead"
                />
                <Walkthrough
                    lang={lang}
                    id="setup"
                    title={v.setup.title}
                    summary={v.setup.summary}
                />
                <Walkthrough
                    lang={lang}
                    id="legacy"
                    title={v.legacy.title}
                    summary={v.legacy.summary}
                />
            </div>
        </div>
    </section>

    <!-- Who it's for -->
    <section class="section rule-top" aria-labelledby="use-title">
        <div class="wrap grid gap-10 lg:grid-cols-[1fr_1.4fr]">
            <h2 id="use-title" class="h2">
                {copy.useTitle}
            </h2>
            <ul class="uses">
                {copy.uses.map(([label, path]) => (
                    <li>
                        <a href={href(lang, path)}>
                            <span>{label}</span>
                            <Icon name="arrow" size={20} />
                        </a>
                    </li>
                ))}
            </ul>
        </div>
    </section>

    <!-- Lid closed: open source -->
    <section class="lid" aria-labelledby="open-title">
        <div class="wrap grid gap-10 py-20 lg:grid-cols-[1.3fr_1fr] lg:items-end lg:py-28">
            <div>
                <h2 id="open-title" class="h2">
                    {copy.openTitle}
                </h2>
                <p class="lede mt-5">{copy.openBody}</p>
            </div>
            <div class="flex flex-wrap gap-3 lg:justify-end">
                <a class="btn btn-paper" href={LINKS.repo}>
                    <Icon name="github" size={18} />
                    {copy.openRepo}
                </a>
                <a class="btn btn-outline-paper" href={LINKS.contributing}>
                    {copy.openContrib}
                </a>
            </div>
        </div>
    </section>

    <!-- Close -->
    <section class="section" aria-labelledby="close-title">
        <div class="wrap grid items-center gap-10 lg:grid-cols-[1fr_1fr]">
            <div>
                <h2 id="close-title" class="h2">
                    {copy.closeTitle}
                </h2>
                <p class="lede mt-4">{copy.closeBody}</p>
                <a
                    class="link mt-6 inline-flex items-center gap-2 font-medium"
                    href={sectionHref(lang, "docs")}
                >
                    {t("cta.docs")}
                    <Icon name="arrow" size={18} />
                </a>
            </div>
            <InstallTicket lang={lang} id="close-install" />
        </div>
    </section>
</Base>

