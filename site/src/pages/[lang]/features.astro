        link: ["docs/export-formats/", "သိမ်းဆည်းနိုင်တဲ့ File format တွေ"],
      },
      {
        id: "gui-cli",
        title: "အက်ပ်နှင့် CLI၊ တူညီတဲ့စနစ်",
        body: [
          "PySide6 ဖြင့် တည်ဆောက်ထားတဲ့ Desktop app နဲ့ lexo command က အခြေခံစနစ်တစ်ခုတည်းကို သုံးထားတာကြောင့် ရလဒ်တူပါတယ်။ အက်ပ်မှာ အရင်စမ်းပြီး အဲဒီလုပ်ငန်းစဉ်ကို script ရေးကာ ထပ်မံလုပ်ဆောင်နိုင်ပါတယ်။",
        ],
        image: welcome,
        alt: "LEXO အဖွင့်မျက်နှာပြင်။",
        commands: ["lexo gui", "lexo --help"],
