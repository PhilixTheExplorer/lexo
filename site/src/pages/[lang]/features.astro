const copy = content[lang];
const crumbs = [{ label: t("breadcrumb.home"), href: href(lang) }, { label: t("nav.features") }];
const url = new URL(href(lang, "features/"), site).href;
---

<Base
  lang={lang}
  title={copy.title}
  description={copy.description}
  section="features"
  path="features/"
  ogImage={`/og/${lang}/features.png`}
  jsonLd={[
    softwareApplication(lang, url, copy.description),
    breadcrumbList([
      { name: t("breadcrumb.home"), url: new URL(href(lang), site).href },
      { name: t("nav.features"), url },
    ]),
  ]}
>
  <div class="wrap pt-10 lg:pt-14">
    <Breadcrumbs items={crumbs} label={t("breadcrumb.home")} />
    <div class="intro mt-6">
      <h1 class="display">{copy.h1}</h1>
      <p class="lede">{copy.lede}</p>
    </div>

    <nav class="index mt-14" aria-label={t("nav.features")}>
      <ol>
        {
          copy.features.map((f) => (
            <li>
              <a href={`#${f.id}`}>{f.title}</a>
            </li>
          ))
        }
      </ol>
    </nav>
  </div>

  <div class="wrap pb-20">
    {
      copy.features.map((f) => (
        <section id={f.id} class:list={["feature", !f.image && "no-image"]} aria-labelledby={`${f.id}-h`}>
          <div class="feature-text">
            <h2 id={`${f.id}-h`} class="h2 feature-title">
              {f.title}
            </h2>
            {f.body.map((p) => (
              <p class="mt-4 text-ink-2">{p}</p>
            ))}
            {f.commands && (
              <div class="mt-6 grid gap-2">
                {f.commands.map((c) => (
                  <Command lang={lang} command={c} />
                ))}
              </div>
            )}
            {f.link && (
              <a class="link mt-6 inline-flex items-center gap-2 font-medium" href={href(lang, f.link[0])}>
                {f.link[1]}
                <Icon name="arrow" size={18} />
              </a>
            )}
          </div>
          {f.image && f.alt && (
            <Shot src={f.image} alt={f.alt} sizes="(min-width: 64rem) 56vw, 94vw" class="feature-shot" />
          )}
        </section>
      ))
    }
  </div>
</Base>

<style>
  .intro {
    display: grid;
    gap: 1.5rem;
  }

  @media (min-width: 64rem) {
    .intro {
      grid-template-columns: 1.1fr 1fr;
      align-items: end;
      gap: 4rem;
    }
  }

  .index ol {
    list-style: none;
    margin: 0;
    padding: 0;
    columns: 1;
    column-gap: 2.5rem;
    border-top: 1.5px solid var(--ink);
  }

  @media (min-width: 40rem) {
    .index ol {
      columns: 2;
    }
  }

  @media (min-width: 64rem) {
    .index ol {
      columns: 3;
    }
  }

  .index li {
    break-inside: avoid;
  }

  .index a {
    display: flex;
    gap: 0.9rem;
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--rule);
    color: var(--ink);
    text-decoration: none;
    font-weight: 560;
  }

  @media (hover: hover) and (pointer: fine) {
    .index a:hover {
      color: var(--scan-ink);
    }
  }

  .feature {
    display: grid;
    gap: 2rem;
    padding-block: clamp(3.5rem, 7vw, 6rem);
    border-bottom: 1px solid var(--rule);
    scroll-margin-top: 6rem;
  }

  .feature-text {
    max-width: 34rem;
  }

  .feature-title {
    font-size: clamp(1.6rem, 1.2rem + 1.4vw, 2.4rem);
  }

  @media (min-width: 64rem) {
    .feature {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.4fr);
      gap: 4rem;
      align-items: start;
    }

    .feature:nth-of-type(even) :global(.feature-shot) {
      order: -1;
    }

    .feature-text {
      position: sticky;
      top: 7.5rem;
    }

    .feature.no-image {
      grid-template-columns: minmax(0, 1fr);
    }

    .feature.no-image .feature-text {
      max-width: 44rem;
      position: static;
    }
  }
</style>
