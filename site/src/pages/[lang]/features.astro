---
import type { ImageMetadata } from "astro";
import batchDialog from "~/assets/screens/app-batch-dialog.webp";
import cropEditor from "~/assets/screens/app-crop-editor.webp";
import exportShot from "~/assets/screens/app-export.webp";
import ocrResult from "~/assets/screens/app-ocr-result.webp";
import ocrRunning from "~/assets/screens/app-ocr-running.webp";
import proofread from "~/assets/screens/app-proofread.webp";
import splitSpread from "~/assets/screens/app-split-spread.webp";
import textLayer from "~/assets/screens/app-text-layer.webp";
import welcome from "~/assets/screens/app-welcome.webp";
import legacyFrame from "~/assets/screens/legacy-font-extract.webp";
import Breadcrumbs from "~/components/Breadcrumbs.astro";
import Command from "~/components/Command.astro";
import Icon from "~/components/Icon.astro";
import Shot from "~/components/Shot.astro";
import type { Lang } from "~/i18n/ui";
import { href, staticLangPaths, useT } from "~/i18n/utils";
import Base from "~/layouts/Base.astro";
import { breadcrumbList, softwareApplication } from "~/lib/schema";

export const getStaticPaths = staticLangPaths;

const lang = Astro.params.lang as Lang;
const t = useT(lang);
const site = Astro.site ?? new URL("https://lexo.philix.dev");

interface Feature {
  id: string;
  title: string;
  body: string[];
  image?: ImageMetadata;
  alt?: string;
  commands?: string[];
  link?: [string, string];
}

const content: Record<
  Lang,
  { title: string; h1: string; description: string; lede: string; features: Feature[] }
> = {
  en: {
    title: "Features: Burmese OCR, PDF tools, and proofreading",
    h1: "What LEXO does",
