    lede: "Every capability below exists in the current release, and each one is shown in the real app. Nothing here is a roadmap.",
    features: [
      {
        id: "burmese-ocr",
        title: "Burmese-first OCR",
        body: [
          "Burmese is the default OCR language. You don't pick it, configure it, or install a language pack.",
          "LEXO uses Google Docs OCR, which reads Myanmar script well, and wraps it in a workflow built around Burmese documents: scanned books, old PDFs, and legacy-font files.",
        ],
        image: ocrResult,
        alt: "A scanned Burmese page beside its Google Docs OCR text in LEXO.",
        link: ["docs/ocr-workflows/", "OCR workflows"],
      },
      {
        id: "google-docs-ocr",
        title: "Google Docs OCR through your own account",
        body: [
          "No paid OCR API, no per-page fee, and no large local model download. LEXO sends each page image to your own Google Drive, lets Google Docs OCR read it, takes the text, and deletes the temporary file.",
          "It needs a one-time Google Cloud setup, and access is limited to the drive.file scope: only the files LEXO creates.",
        ],
        image: ocrRunning,
        alt: "LEXO running Google Docs OCR, with per-page progress.",
