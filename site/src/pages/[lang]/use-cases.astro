        ],
        caveat:
          "စာမျက်နှာကို ပြန့်ပြန့်ထားပြီး အလင်းရောင်ကောင်းကောင်းနဲ့ ကြည်လင်အောင် ရိုက်ထားတဲ့ပုံတွေက ရလဒ်အကောင်းဆုံး ရစေပါတယ်။ လက်ရေးကိုမူ LEXO က အထူးတည်ဆောက် စမ်းသပ်ထားခြင်း မရှိပါဘူး။",
        links: [["docs/desktop-app/", "Desktop app လမ်းညွှန်"]],
      },
    ],
  },
};

const copy = content[lang];
const crumbs = [{ label: t("breadcrumb.home"), href: href(lang) }, { label: t("nav.useCases") }];
---

<Base
  lang={lang}
  title={copy.title}
  description={copy.description}
  section="useCases"
  path="use-cases/"
  ogImage={`/og/${lang}/use-cases.png`}
  jsonLd={[
    breadcrumbList([
      { name: t("breadcrumb.home"), url: new URL(href(lang), site).href },
      { name: t("nav.useCases"), url: new URL(href(lang, "use-cases/"), site).href },
    ]),
  ]}
>
  <div class="wrap pt-10 pb-24 lg:pt-14">
    <Breadcrumbs items={crumbs} label={t("breadcrumb.home")} />
    <h1 class="display mt-6 max-w-5xl">{copy.h1}</h1>
    <p class="lede mt-5">{copy.lede}</p>

    <nav class="jump mt-10" aria-label={t("nav.useCases")}>
      {copy.cases.map((c) => <a href={`#${c.id}`}>{c.title}</a>)}
    </nav>

    {
      copy.cases.map((c) => (
        <section id={c.id} class="case" aria-labelledby={`${c.id}-h`}>
          <div class="case-head">
            <h2 id={`${c.id}-h`} class="h2">
              {c.title}
            </h2>
            <p class="lede mt-4">{c.situation}</p>
          </div>
          <div class="case-body">
            <h3 class="folio">{copy.howLabel}</h3>
            <ol class="steps">
              {c.steps.map((s) => (
                <li>{s}</li>
              ))}
            </ol>
            {c.commands && (
              <div class="mt-6 grid gap-2">
                {c.commands.map((cmd) => (
                  <Command lang={lang} command={cmd} />
                ))}
              </div>
            )}
            <div class="mind">
              <h3 class="folio">{copy.mindLabel}</h3>
              <p class="mt-2 text-ink-2">{c.caveat}</p>
            </div>
            <ul class="mt-6 flex flex-wrap gap-x-6 gap-y-2">
              {c.links.map(([path, label]) => (
                <li>
                  <a class="link inline-flex items-center gap-1.5 font-medium" href={href(lang, path)}>
                    {label}
                    <Icon name="arrow" size={16} />
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </section>
      ))
    }
  </div>
</Base>

<style>
  .jump {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .jump a {
    padding: 0.45rem 0.8rem;
    border: 1px solid var(--rule-strong);
    border-radius: 3px;
    font-size: var(--fs-ui);
    text-decoration: none;
    color: var(--ink-2);
    transition:
      border-color 160ms ease,
      color 160ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .jump a:hover {
      border-color: var(--ink);
      color: var(--ink);
    }
  }

  .case {
    display: grid;
    gap: 2rem;
    margin-top: clamp(3.5rem, 7vw, 5.5rem);
    padding-top: 2rem;
    border-top: 1.5px solid var(--ink);
    scroll-margin-top: 6rem;
  }

  @media (min-width: 64rem) {
    .case {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 4rem;
    }
  }

  .steps {
    margin: 0.75rem 0 0;
    padding: 0;
    list-style: none;
    counter-reset: s;
    border-top: 1px solid var(--rule);
  }

  .steps li {
    counter-increment: s;
    position: relative;
    padding: 0.8rem 0 0.8rem 2.25rem;
    border-bottom: 1px solid var(--rule);
    color: var(--ink-2);
  }

  .steps li::before {
    content: counter(s, decimal-leading-zero);
    position: absolute;
    left: 0;
    top: 0.95rem;
    font-family: var(--font-mono);
    font-stretch: 87%;
    font-size: var(--fs-label);
    color: var(--scan-ink);
  }

  :global(:lang(my)) .steps li::before {
    content: counter(s, myanmar);
    font-family: var(--font-my);
    font-size: var(--fs-sm);
    top: 0.8rem;
  }

  .mind {
    margin-top: 1.75rem;
    padding: 1rem 1.1rem;
    background: var(--platen);
    border-radius: 3px;
  }
</style>
