---
import { Image } from "astro:assets";
import logo from "~/assets/lexo.png";
import { LICENSE_NAME, LINKS, VERSION } from "~/data/site";
import type { Lang } from "~/i18n/ui";
import { href, sectionHref, useT } from "~/i18n/utils";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useT(lang);

const columns = [
  {
    title: t("footer.product"),
    links: [
      { label: t("nav.features"), href: sectionHref(lang, "features") },
      { label: t("nav.useCases"), href: sectionHref(lang, "useCases") },
      { label: t("nav.download"), href: sectionHref(lang, "download") },
      { label: t("nav.changelog"), href: sectionHref(lang, "changelog") },
    ],
  },
  {
    title: t("footer.learn"),
    links: [
      { label: t("nav.docs"), href: sectionHref(lang, "docs") },
      {
        label: lang === "my" ? "Google OCR Setup" : "Google OCR setup",
        href: href(lang, "docs/google-cloud-setup/"),
      },
      { label: t("nav.blog"), href: sectionHref(lang, "blog") },
      { label: t("nav.faq"), href: sectionHref(lang, "faq") },
    ],
  },
  {
    title: t("footer.project"),
    links: [
      { label: "GitHub", href: LINKS.repo },
      { label: t("footer.pypi"), href: LINKS.pypi },
      { label: t("footer.releases"), href: LINKS.releases },
      { label: t("footer.issues"), href: LINKS.issues },
      { label: t("footer.contributing"), href: LINKS.contributing },
    ],
  },
];
---

<footer class="mt-auto border-t border-rule bg-paper">
  <div class="wrap grid gap-10 py-14 md:grid-cols-[1.4fr_repeat(3,1fr)]">
    <div class="max-w-xs">
      <a href={sectionHref(lang, "home")} class="inline-flex items-center gap-2 no-underline">
        <Image src={logo} alt="" width={28} height={28} class="size-7" />
        <span class="text-lg font-extrabold tracking-normal" style="font-stretch:118%;font-family:var(--font-display)" lang="en"
          >LEXO</span
        >
      </a>
      <p class="mt-3 text-(length:--fs-sm) text-ink-2">{t("footer.tagline")}</p>
      <p class="mt-4 folio">
        <span lang="en">v{VERSION}</span> · {t("footer.maintainer")}
        <a class="link normal-case" href={LINKS.author} lang="en">PhilixTheExplorer</a>
      </p>
    </div>
    {
      columns.map((col) => (
        <div>
          <h2 class="folio mb-3">{col.title}</h2>
          <ul class="space-y-1.5 text-(length:--fs-sm)">
            {col.links.map((link) => (
              <li>
                <a class="link text-ink-2 no-underline hover:text-ink" href={link.href}>
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
  <div class="border-t border-rule">
    <div class="wrap flex flex-col gap-2 py-5 text-sm text-ink-3 md:flex-row md:justify-between">
      <p>
        <a class="link text-ink-3" href={LINKS.license}
          >{t("footer.license", { license: LICENSE_NAME })}</a
        >
      </p>
      <p class="max-w-2xl md:text-right">{t("footer.notAffiliated")}</p>
    </div>
  </div>
</footer>
