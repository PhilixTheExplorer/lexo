---
import poster1 from "~/assets/posters/walkthrough-1.webp";
import poster2 from "~/assets/posters/walkthrough-2.webp";
import poster3 from "~/assets/posters/walkthrough-3.webp";
import YouTubeEmbed from "~/components/YouTubeEmbed.astro";
import { VIDEOS, type VideoId } from "~/data/site";
import type { Lang } from "~/i18n/ui";
import { useT } from "~/i18n/utils";

interface Props {
  lang: Lang;
  id: VideoId;
  title: string;
  summary?: string;
  headingLevel?: 2 | 3;
  class?: string;
}

const { lang, id, title, summary, headingLevel = 3, class: className } = Astro.props;
const t = useT(lang);
const video = VIDEOS.find((v) => v.id === id);
if (!video) throw new Error(`Unknown video ${id}`);
const poster = { setup: poster1, scanned: poster2, legacy: poster3 }[id];
const minutes = Math.floor(video.seconds / 60);
const seconds = String(video.seconds % 60).padStart(2, "0");
const Heading = `h${headingLevel}` as "h2" | "h3";
---

<figure class:list={["walkthrough", className]}>
  <YouTubeEmbed
    youtubeId={video.youtubeId}
    poster={poster}
    posterWidth={960}
    title={title}
    playLabel={t("video.play")}
  />
  <figcaption>
    <Heading class="h3 text-ink">{title}</Heading>
    {summary && <p class="mt-1.5 text-ink-2">{summary}</p>}
    <p class="folio mt-2">
      {t("video.length")} <span lang="en">{minutes}:{seconds}</span> · {t("video.noSound")}
    </p>
  </figcaption>
</figure>

<style>
  figcaption {
    margin-top: 0.9rem;
  }
</style>
