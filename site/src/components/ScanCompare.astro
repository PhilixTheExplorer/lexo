---
import { Picture } from "astro:assets";
import after from "~/assets/screens/hero-after.webp";
import before from "~/assets/screens/hero-before.webp";
import type { Lang } from "~/i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const copy = {
  en: {
    label: "Scan bar position",
    altBefore:
      "LEXO window before OCR: a scanned Burmese page in the preview and an empty text pane.",
    altAfter:
      "LEXO window after Google Docs OCR: the same scanned Burmese page beside its recognized Myanmar Unicode text.",
    caption:
      "The real LEXO window, before and after one Google Docs OCR run. The sample page is set from LEXO's own Burmese README. Drag the bar or use the arrow keys.",
  },
  my: {
    label: "နှိုင်းယှဉ်မျဉ်း တည်နေရာ",
    altBefore:
      "OCR မလုပ်မီ LEXO ဝင်းဒိုး - စကင်ဖတ်ထားတဲ့ မြန်မာစာမျက်နှာနှင့် စာသားမရှိသေးတဲ့ အကွက်။",
    altAfter:
      "Google Docs OCR ပြီးနောက် စကင်စာမျက်နှာနှင့် ရလာတဲ့ မြန်မာ Unicode စာသားကို LEXO မှာ ယှဉ်တွဲပြထားပုံ။",
    caption:
      "Google Docs OCR မလုပ်မီနဲ့ လုပ်ပြီးနောက်ကို နှိုင်းယှဉ်ပြထားပါတယ်။ နမူနာစာမျက်နှာအတွက် LEXO ရဲ့ မြန်မာ README ထဲက စာသားကို သုံးထားပါတယ်။ မျဉ်းကို ဆွဲရွှေ့ပါ သို့မဟုတ် Arrow keys ကို သုံးပါ။",
  },
}[lang];
---

<figure class="scan-compare" data-scan-compare>
  <div class="platen bed">
    <div class="stage" data-stage>
      <Picture
        src={before}
        alt={copy.altBefore}
        formats={["avif"]}
        fallbackFormat="webp"
        widths={[640, 960, 1280, 1600]}
        sizes="(min-width: 64rem) 46vw, 92vw"
        loading="eager"
        class="layer before"
      />
      <div class="after-clip" data-after>
        <Picture
          src={after}
          alt={copy.altAfter}
          formats={["avif"]}
        fallbackFormat="webp"
          widths={[640, 960, 1280, 1600]}
          sizes="(min-width: 64rem) 46vw, 92vw"
          loading="eager"
          fetchpriority="high"
          class="layer"
        />
      </div>
      <div class="track" data-track>
        <div class="scan-lamp lamp" aria-hidden="true"><span class="grip"></span></div>
      </div>
      <input
        class="scrubber"
        type="range"
        min="0"
        max="100"
        step="1"
        value="62"
        aria-label={copy.label}
        aria-valuetext="62%"
        data-scrubber
      />
    </div>
  </div>
  <figcaption class="caption">{copy.caption}</figcaption>
</figure>

<style>
  .bed {
    padding: clamp(0.6rem, 1.6vw, 1.1rem);
  }

  .stage {
    position: relative;
    overflow: hidden;
    border-radius: 3px;
    background: #11151c;
    box-shadow:
      0 0 0 1px rgb(0 0 0 / 0.3),
      var(--shadow);
    touch-action: pan-y;
    cursor: ns-resize;
    user-select: none;
  }

  .stage :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  .after-clip {
    position: absolute;
    inset: 0;
    clip-path: inset(0 0 38% 0);
  }

  /* The track is as tall as the stage, so translateY(%) moves the lamp by a share of the
     stage height: the sweep animates only transform and clip-path, never layout. */
  .track {
    position: absolute;
    inset: 0;
    transform: translateY(62%);
    pointer-events: none;
  }

  .lamp {
    top: 0;
    translate: 0 -50%;
    pointer-events: auto;
    touch-action: none;
  }

  /* A taller invisible hit zone so a finger can catch the 3px lamp without blocking scroll elsewhere. */
  .lamp::after {
    content: "";
    position: absolute;
    inset: -22px 0;
  }

  .grip {
    position: absolute;
    right: 10px;
    top: 50%;
    width: 30px;
    height: 18px;
    translate: 0 -50%;
    border-radius: 3px;
    background: var(--scan);
    box-shadow: 0 2px 8px rgb(0 0 0 / 0.35);
  }

  .grip::before {
    content: "";
    position: absolute;
    inset: 6px 9px;
    border-block: 1.5px solid rgb(20 21 25 / 0.55);
  }

  .scrubber {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    cursor: ns-resize;
    pointer-events: none;
  }

  .stage:has(.scrubber:focus-visible) {
    outline: 2px solid var(--scan-ink);
    outline-offset: 4px;
  }

  .scan-compare.is-sweeping .track {
    animation: sweep-lamp 2.1s var(--ease-in-out) 350ms both;
  }

  .scan-compare.is-sweeping .after-clip {
    animation: sweep-reveal 2.1s var(--ease-in-out) 350ms both;
  }

  @keyframes sweep-lamp {
    from {
      transform: translateY(0%);
    }
    to {
      transform: translateY(62%);
    }
  }

  @keyframes sweep-reveal {
    from {
      clip-path: inset(0 0 100% 0);
    }
    to {
      clip-path: inset(0 0 38% 0);
    }
  }

  .caption {
    margin-top: 0.8rem;
    max-width: 46rem;
    font-size: var(--fs-caption);
    line-height: 1.55;
    color: var(--ink-3);
  }

  :global(:lang(my)) .caption {
    line-height: 1.9;
  }

  @media (prefers-reduced-motion: reduce) {
    .scan-compare.is-sweeping :is(.track, .after-clip) {
      animation: none;
    }
  }
</style>

<script>
  for (const figure of document.querySelectorAll<HTMLElement>("[data-scan-compare]")) {
    const stage = figure.querySelector<HTMLElement>("[data-stage]");
    const input = figure.querySelector<HTMLInputElement>("[data-scrubber]");
    const track = figure.querySelector<HTMLElement>("[data-track]");
    const reveal = figure.querySelector<HTMLElement>("[data-after]");
    if (!stage || !input || !track || !reveal) continue;

    const set = (pct: number) => {
      const value = Math.min(100, Math.max(0, pct));
      track.style.transform = `translateY(${value}%)`;
      reveal.style.clipPath = `inset(0 0 ${100 - value}% 0)`;
      input.value = String(Math.round(value));
      input.setAttribute("aria-valuetext", `${Math.round(value)}%`);
    };

    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (!reduce) {
      figure.classList.add("is-sweeping");
      track.addEventListener(
        "animationend",
        () => {
          figure.classList.remove("is-sweeping");
          set(62);
        },
        { once: true },
      );
    }

    const fromPointer = (event: PointerEvent) => {
      const rect = stage.getBoundingClientRect();
      set(((event.clientY - rect.top) / rect.height) * 100);
    };

    stage.addEventListener("pointerdown", (event) => {
      if (event.button !== 0) return;
      const onLamp = (event.target as Element).closest(".lamp");
      if (event.pointerType !== "mouse" && !onLamp) return;
      figure.classList.remove("is-sweeping");
      stage.setPointerCapture(event.pointerId);
      fromPointer(event);
      input.focus({ preventScroll: true });
    });
    stage.addEventListener("pointermove", (event) => {
      if (stage.hasPointerCapture(event.pointerId)) fromPointer(event);
    });

    input.addEventListener("input", () => {
      figure.classList.remove("is-sweeping");
      set(Number(input.value));
    });
    input.addEventListener("keydown", (event) => {
      // A vertical scrubber: up/down map to the bar moving up/down the page.
      const step = event.shiftKey ? 10 : 2;
      if (event.key === "ArrowDown" || event.key === "ArrowRight") set(Number(input.value) + step);
      else if (event.key === "ArrowUp" || event.key === "ArrowLeft") set(Number(input.value) - step);
      else if (event.key === "Home") set(0);
      else if (event.key === "End") set(100);
      else return;
      event.preventDefault();
      figure.classList.remove("is-sweeping");
    });
  }
</script>
