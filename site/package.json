{
  "name": "lexo-site",
  "private": true,
  "type": "module",
  "description": "Product website for Lexo, the Burmese-first desktop OCR app.",
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@11.27.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "wrangler dev",
    "preview:astro": "astro preview",
    "deploy": "astro build && wrangler deploy",
    "check": "astro check && biome check .",
    "typecheck": "astro check",
    "lint": "biome check .",
    "format": "biome format --write .",
    "og": "node scripts/og.mjs"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@astrojs/mdx": "8.1.1",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "@biomejs/biome": "2.6.2",
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource-variable/martian-mono": "5.3.0",
    "@fontsource/padauk": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.4.2",
    "puppeteer-core": "24.43.1",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "wrangler": "4.151.3"
  }
}
